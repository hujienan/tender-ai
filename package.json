{
  "name": "tender-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "fixtures:generate": "node --experimental-strip-types scripts/generate-fixtures.ts",
    "assess": "node --experimental-strip-types scripts/assess.ts",
    "db:init": "node --experimental-strip-types scripts/db-init.ts",
    "index:documents": "node --experimental-strip-types scripts/index-documents.ts",
    "revalidate": "node --experimental-strip-types scripts/revalidate.ts",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages,scripts,tests}/**/*.{ts,tsx}\" eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"{apps,packages,scripts,tests}/**/*.{ts,tsx}\" eslint.config.mjs .prettierrc.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.11.0",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@langchain/aws": "1.4.7",
    "@langchain/core": "1.2.18",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
